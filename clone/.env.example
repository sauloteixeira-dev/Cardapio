# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Supabase.
# Veja replica/backend.md > "Criar o projeto Supabase" para onde encontrar cada um.
# Nunca comite .env.local — o .gitignore já deixa ele de fora, de propósito.

# Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings > API > Project API keys > service_role (secreta — nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=
